# Google Apps Script web app URL used by RSVP, guest list, story, details,
# entourage, and wishlist. Deploy the script in google-apps-script/Code.gs as
# a web app with access set to "Anyone", then paste the /exec URL below.
# Example: https://script.google.com/macros/s/AKfycbw.../exec
VITE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/AKfycbwREPLACE_WITH_YOUR_DEPLOYMENT_ID/exec
